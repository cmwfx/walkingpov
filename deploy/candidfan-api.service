[Unit]
Description=CandidFan API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=candidfan
WorkingDirectory=/var/www/candidfan/current
EnvironmentFile=/etc/candidfan/api.env
ExecStart=/usr/bin/env node /var/www/candidfan/current/server/dist/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/lib/candidfan

[Install]
WantedBy=multi-user.target
