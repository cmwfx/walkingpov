[Unit]
Description=CandidFan media signature verifier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=candidfan-media
WorkingDirectory=/opt/candidfan-media
EnvironmentFile=/etc/candidfan/media.env
ExecStart=/usr/bin/env node /opt/candidfan-media/dist/verifier.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/srv/candidfan/state

[Install]
WantedBy=multi-user.target
