[Unit]
Description=CandidFan resumable video preview backfill
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=candidfan-media
Group=candidfan-media
WorkingDirectory=/opt/candidfan-tools
EnvironmentFile=/etc/candidfan/importer.env
Environment=MEDIA_ROOT=/srv/candidfan/media
Environment=PREVIEW_ROOT=/srv/candidfan/previews
ExecStart=/opt/candidfan-tools/generate-video-previews.sh
TimeoutStartSec=infinity
Restart=no
Nice=15
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/candidfan/media
ReadWritePaths=/srv/candidfan/previews

[Install]
WantedBy=multi-user.target
