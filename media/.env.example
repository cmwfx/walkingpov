# Keep MEDIA_SIGNING_SECRET identical to the old site's API signing secret.
MEDIA_SIGNING_SECRET=
PORT=3100
MEDIA_ROOT=/srv/candidfan/media
THUMBNAIL_ROOT=/srv/candidfan/thumbnails
# Exact CandidFan origins only. Keep the Nginx map in media/nginx.conf synchronized.
CORS_ORIGINS=https://candidfan.com,https://www.candidfan.com
