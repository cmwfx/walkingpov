WEB_API_URL=https://candidfan.com/api
WORKER_TOKEN=replace-with-the-storage-worker-token
WORKER_ID=candidfan-runpod-backlog
REMOTE_STORAGE_HOST=162.35.121.186
REMOTE_STORAGE_PORT=22
REMOTE_STORAGE_USER=candidfan-processor
REMOTE_STORAGE_KEY_PATH=/runpod/secrets/storage-vps-rsa
REMOTE_INBOX_ROOT=/root/videos
REMOTE_MEDIA_ROOT=/srv/candidfan-media
WORK_ROOT=/tmp/candidfan-runpod
# Defaults to min(4, detected vCPUs), then concurrency is detected vCPUs / threads.
FFMPEG_THREADS=
# Override only after benchmarking. The default uses the full detected vCPU budget.
PROCESS_CONCURRENCY=
PROCESS_LIMIT=0
POLL_INTERVAL_MS=15000
