NODE_ENV=production
PORT=3001
FRONTEND_URL=https://candidfan.com
MEDIA_BASE_URL=https://media.candidfan.com
SUPABASE_URL=https://ghredjydntjlfykgrqqq.supabase.co
SUPABASE_SECRET_KEY=replace_with_target_secret_key
ENCRYPTION_KEY=64_hex_characters
MEDIA_SIGNING_SECRET=long_random_secret
IMPORTER_TOKEN=long_random_secret
IMPORT_SOURCE_KIND=originals
# Leave disabled after card-checkout cutover; legacy pending reviews remain available.
LEGACY_GIFTCARD_SUBMISSIONS_ENABLED=false
# Old catalog downloads must stay disabled after InstantVidGrab download routing is enabled.
LEGACY_DIRECT_DOWNLOADS_ENABLED=false
# Independent rollout switches. Keep both off until the corresponding journey is accepted.
INSTANTVIDGRAB_CHECKOUT_ENABLED=false
INSTANTVIDGRAB_DOWNLOADS_ENABLED=false
# Only enable email-bearing membership migration pages in a controlled migration window.
INSTANTVIDGRAB_LEGACY_MEMBER_MIGRATION_ENABLED=false
# Migration requests are denied unless this runtime matches a non-production branch URL.
INSTANTVIDGRAB_LEGACY_MEMBER_MIGRATION_ENV=
INSTANTVIDGRAB_LEGACY_MEMBER_MIGRATION_SANDBOX_SUPABASE_REF=
# Exact InstantVidGrab callback URL for this environment.
INSTANTVIDGRAB_AUTHORIZATION_CALLBACK_URL=https://instantvidgrab.online/connect/callback
# InstantVidGrab API origin used by the durable legacy-membership outbox worker.
INSTANTVIDGRAB_API_BASE_URL=https://instantvidgrab.online
# Directional key pair must match InstantVidGrab's IVG_TO_WALKINGPOV pair.
IVG_TO_WALKINGPOV_HMAC_CURRENT_KEY_ID=
IVG_TO_WALKINGPOV_HMAC_CURRENT_SECRET=
IVG_TO_WALKINGPOV_HMAC_PREVIOUS_KEY_ID=
IVG_TO_WALKINGPOV_HMAC_PREVIOUS_SECRET=
WALKINGPOV_TO_IVG_HMAC_CURRENT_KEY_ID=
WALKINGPOV_TO_IVG_HMAC_CURRENT_SECRET=
WALKINGPOV_TO_IVG_HMAC_PREVIOUS_KEY_ID=
WALKINGPOV_TO_IVG_HMAC_PREVIOUS_SECRET=
ADMIN_EMAIL=owner@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=replace_me
SMTP_FROM=CandidFan <no-reply@candidfan.com>
